<?xml version="1.0"?>
<launch>
    <!-- Spherical heatmap node with isotope identification.
         Subscribes to /compton_event, publishes /sphere_heatmap, /source_direction, /source_isotopes. -->
    <arg name="radius" default="0.5"/>
    <arg name="n_points" default="2000"/>
    <arg name="window_s" default="120.0"/>
    <arg name="update_period_s" default="2.0"/>
    <arg name="min_events" default="50"/>
    <arg name="max_events" default="20000"/>
    <arg name="hemisphere_only" default="true"/>
    <arg name="min_peak_separation_deg" default="20.0"/>
    <!-- Secondary source must reach this fraction of the strongest peak's score
         to be reported. Lower = more sensitive to weaker/off-axis sources
         (0.5 default); raise toward 0.75 if noise creates spurious peaks. -->
    <arg name="peak_threshold" default="0.5"/>
    <arg name="max_peaks" default="5"/>
    <!-- Temporal persistence to reject flickering ghost peaks (Compton cone
         cross-talk). A peak must appear in >= peak_persist_min of the last
         peak_persist_frames frames. Set peak_persist_min=1 to disable. -->
    <arg name="peak_persist_frames" default="4"/>
    <arg name="peak_persist_min" default="2"/>
    <arg name="peak_persist_tol_deg" default="8.0"/>
    <!-- Ghost suppression by event support: a peak is kept only if enough events'
         cones actually pass through it, relative to the strongest peak. Raise
         support_ratio to reject more ghosts; lower it to keep weaker real
         sources. min_source_events is an absolute floor. -->
    <arg name="support_ratio" default="0.5"/>
    <arg name="min_source_events" default="15"/>
    <arg name="attribution_tol_deg" default="6.0"/>
    <!-- Alternative CLEAN-style iterative extraction (off; can over-produce
         peaks with strong multi-source scenes). -->
    <arg name="iterative_extraction" default="false"/>
    <!-- Isotope config: source of the dose-rate gamma constants (single source
         of truth, shared with the activity and data-recorder nodes). -->
    <arg name="isotopes_config" default="$(find phds_gegi_driver)/config/isotopes.yaml"/>
    <!-- Nuclide ID library: identified isotopes (/identified_isotopes from the
         data recorder's screening layer) get their own imaging band, centred on
         the representative line +- id_band_window_kev, in addition to the
         built-in Cs/Co bands. -->
    <arg name="nuclide_library" default="$(find phds_gegi_driver)/config/nuclide_library.yaml"/>
    <arg name="id_band_window_kev" default="30.0"/>

    <node name="spherical_heatmap" pkg="phds_gegi_driver" type="spherical_heatmap_node.py" output="screen">
        <param name="isotopes_config" value="$(arg isotopes_config)" />
        <param name="nuclide_library" value="$(arg nuclide_library)" />
        <param name="id_band_window_kev" type="double" value="$(arg id_band_window_kev)" />
        <param name="support_ratio" type="double" value="$(arg support_ratio)" />
        <param name="radius" type="double" value="$(arg radius)" />
        <param name="n_points" type="int" value="$(arg n_points)" />
        <param name="window_s" type="double" value="$(arg window_s)" />
        <param name="update_period_s" type="double" value="$(arg update_period_s)" />
        <param name="min_events" type="int" value="$(arg min_events)" />
        <param name="max_events" type="int" value="$(arg max_events)" />
        <param name="hemisphere_only" type="bool" value="$(arg hemisphere_only)" />
        <param name="peak_min_separation_deg" type="double" value="$(arg min_peak_separation_deg)" />
        <param name="peak_threshold" type="double" value="$(arg peak_threshold)" />
        <param name="max_peaks" type="int" value="$(arg max_peaks)" />
        <param name="peak_persist_frames" type="int" value="$(arg peak_persist_frames)" />
        <param name="peak_persist_min" type="int" value="$(arg peak_persist_min)" />
        <param name="peak_persist_tol_deg" type="double" value="$(arg peak_persist_tol_deg)" />
        <param name="iterative_extraction" type="bool" value="$(arg iterative_extraction)" />
        <param name="min_source_events" type="int" value="$(arg min_source_events)" />
        <param name="attribution_tol_deg" type="double" value="$(arg attribution_tol_deg)" />
    </node>
</launch>
