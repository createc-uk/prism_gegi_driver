ARG DEFAULT_WORKING_DIRECTORY=/opt/phds_gegi_driver

FROM ubuntu:22.04 AS base

ARG DEBIAN_FRONTEND=noninteractive
ARG DEFAULT_WORKING_DIRECTORY

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
USER root

ENV WORKING_DIRECTORY=${DEFAULT_WORKING_DIRECTORY} \
    PYTHONUNBUFFERED=1

COPY ./setup/phds_gegi_driver/setup_dependencies.sh /tmp/setup_dependencies.sh
RUN chmod +x /tmp/setup_dependencies.sh \
    && /tmp/setup_dependencies.sh \
    && rm -f /tmp/setup_dependencies.sh

FROM base AS builder

ARG DEFAULT_WORKING_DIRECTORY
# Constrain CMake and Python wheel builds on memory-limited build workers.
ENV WORKING_DIRECTORY=${DEFAULT_WORKING_DIRECTORY} \
    CMAKE_BUILD_PARALLEL_LEVEL=3

WORKDIR /build-source

# Keep the C++ driver build separate from the Python binding build: the driver
# project intentionally forces PSM_BUILD_PYTHON_BINDINGS=OFF.
COPY ./CMakeLists.txt ./CMakeLists.txt
COPY ./include ./include
COPY ./src ./src
COPY ./deps ./deps
# Include test sources because the root CMake project defines coverage targets.
COPY ./test ./test

RUN cmake -S /build-source -B /tmp/phds-gegi-build -G Ninja \
        -DCMAKE_RUNTIME_OUTPUT_DIRECTORY=/tmp/phds-gegi-build/bin \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_PSM_TOOLS=ON \
        -DNATSMESSAGING_BUILD_TESTS=OFF \
    && cmake --build /tmp/phds-gegi-build \
        --target phds_gegi_driver_node prism_cli \
        --parallel 3 \
    && install -D -m 0755 \
        /tmp/phds-gegi-build/phds_gegi_driver_node \
        ${WORKING_DIRECTORY}/bin/phds_gegi_driver_node \
    && install -D -m 0755 \
        /tmp/phds-gegi-build/bin/prism \
        ${WORKING_DIRECTORY}/bin/prism

# Prism's pyproject.toml uses scikit-build-core and enables the bindings with
# PSM_BUILD_PYTHON_BINDINGS=ON. This is the pip installation flow documented by
# the vendored Prism develop branch.
# Update the Python binding build toolchain (Ubuntu 22.04 packaging is too old).
RUN python3 -m pip install --no-cache-dir --upgrade \
        "pip>=24,<27" "packaging>=24,<27" "setuptools>=68" "wheel>=0.43" \
    && python3 -m pip install --no-cache-dir \
        --target /opt/prism-python \
        /build-source/deps/prism/bindings/python \
    && PYTHONPATH=/opt/prism-python python3 -c "import prism"

FROM base AS runtime

ARG DEFAULT_WORKING_DIRECTORY
ENV WORKING_DIRECTORY=${DEFAULT_WORKING_DIRECTORY} \
    PATH=${DEFAULT_WORKING_DIRECTORY}/bin:/opt/prism-python/bin:${PATH} \
    DRIVER_EXECUTABLE=${DEFAULT_WORKING_DIRECTORY}/bin/phds_gegi_driver_node

LABEL description="Createc PHDS GeGi driver using Prism messaging over NATS"

COPY --from=builder /opt/prism-python /opt/prism-python
COPY --from=builder ${DEFAULT_WORKING_DIRECTORY}/bin ${DEFAULT_WORKING_DIRECTORY}/bin

# Retain the Python runtime nodes, detector configuration, and operational tools.
COPY ./src/phds_gegi_driver ${DEFAULT_WORKING_DIRECTORY}/src/phds_gegi_driver
COPY ./config ${DEFAULT_WORKING_DIRECTORY}/config
COPY ./tools ${DEFAULT_WORKING_DIRECTORY}/tools
COPY ./scripts ${DEFAULT_WORKING_DIRECTORY}/scripts

RUN python3 ${DEFAULT_WORKING_DIRECTORY}/scripts/install_gegi.py --prefix /usr/local --mode native --no-shell

RUN chmod +x ${DEFAULT_WORKING_DIRECTORY}/scripts/run_full_pipeline.sh \
    && mkdir -p ${DEFAULT_WORKING_DIRECTORY}/data

COPY --chown=root:root ./docker/entrypoints/phds_gegi_entrypoint.sh /phds_gegi_entrypoint.sh
RUN sed -i 's/\r$//' /phds_gegi_entrypoint.sh \
    && chmod +x /phds_gegi_entrypoint.sh

WORKDIR ${DEFAULT_WORKING_DIRECTORY}
VOLUME ["/opt/phds_gegi_driver/data"]

ENTRYPOINT ["/phds_gegi_entrypoint.sh"]

CMD ["/opt/phds_gegi_driver/scripts/run_full_pipeline.sh"]
